[Unit]
Description=Minecraft Server Configurator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcsc
Group=mcsc
WorkingDirectory=/opt/mc-server-configurator
Environment=NODE_ENV=production
Environment=MCSC_HOST=0.0.0.0
Environment=MCSC_PORT=4174
Environment=MCSC_DATA_DIR=/var/lib/mc-server-configurator
Environment=MCSC_SERVER_ROOT=/opt/minecraft/servers
Environment=MCSC_BACKUP_ROOT=/opt/minecraft/backups
Environment=MCSC_USE_SUDO=true
ExecStart=/usr/bin/node /opt/mc-server-configurator/dist/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/mc-server-configurator /opt/minecraft/servers /opt/minecraft/backups

[Install]
WantedBy=multi-user.target

